              "type": [
                "string",
                "null"
              ]
            },
            "cmdline": {
              "type": [
                "string",
                "null"
              ]
            },
            "cwd": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "pid": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "pid",
            "name"
          ],
          "type": "object"
        },
        "AgentInfo": {
          "properties": {
            "agent": {
              "type": [
                "string",
                "null"
              ]
            },
            "agent_session": {
              "anyOf": [
                {
                  "$ref": "#/schemas/success_response/$defs/AgentSessionInfo"
                },
                {
                  "type": "null"
                }
              ]
            },
            "agent_status": {
              "$ref": "#/schemas/success_response/$defs/AgentStatus"
            },
