            "launch_pending": {
              "type": "boolean"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "pane_id": {
              "type": "string"
            },
            "revision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "screen_detection_skipped": {
              "type": "boolean"
