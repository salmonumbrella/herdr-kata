                "type": {
                  "const": "pane_process_info",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "process_info"
              ],
              "type": "object"
            },
            {
              "properties": {
                "read": {
                  "$ref": "#/schemas/success_response/$defs/PaneReadResult"
                },
                "type": {
                  "const": "pane_read",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "read"
              ],
              "type": "object"
            },
            {
              "properties": {
                "type": {
                  "const": "ok",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            }
          ]
        },
        "PaneReadResult": {
          "properties": {
            "format": {
              "$ref": "#/schemas/success_response/$defs/ReadFormat"
            },
            "pane_id": {
              "type": "string"
            },
            "revision": {
              "format": "uint64",
              "minimum": 0,
