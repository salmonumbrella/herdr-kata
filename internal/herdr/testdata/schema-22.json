              "maxProperties": 16,
              "propertyNames": {
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              "type": "object"
            },
            "ttl_ms": {
              "format": "uint64",
              "maximum": 86400000,
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "pane_id",
            "source"
