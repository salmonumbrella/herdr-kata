              "type": "object"
            },
            "focus": {
              "default": false,
              "type": "boolean"
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "WorkspaceTarget": {
          "properties": {
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "workspace_id"
          ],
          "type": "object"
        },
        "WorkspaceCreateParams": {
          "properties": {
            "cwd": {
              "type": [
                "string",
                "null"
              ]
            },
            "env": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "focus": {
              "default": false,
              "type": "boolean"
            },
            "label": {
              "type": [
                "string",
                "null"
