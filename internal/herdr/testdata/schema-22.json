              "required": [
                "type",
                "tab",
                "root_pane"
              ],
              "type": "object"
            },
            {
              "properties": {
                "agent": {
                  "$ref": "#/schemas/success_response/$defs/AgentInfo"
                },
                "type": {
                  "const": "agent_info",
                  "type": "string"
