              },
              "required": [
                "type",
                "agent"
              ],
              "type": "object"
            },
            {
              "properties": {
                "agent": {
                  "$ref": "#/schemas/success_response/$defs/AgentInfo"
                },
                "argv": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": {
                  "const": "agent_started",
                  "type": "string"
